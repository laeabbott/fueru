<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Giphy GIF fetching (celebrations) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional: This Week screen calendar-window suggestions. Requested contextually, not at launch. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Android 13+, requested contextually before the first reminder is scheduled -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional haptic tick on set/exercise completion -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Escalation Engine (spec §7.2/§8.2), Stages 0-2. Exact-alarm grant is requested contextually
         from Settings, not at launch (see EscalationPermissions) — not auto-granted on apps
         targeting API 34+, same reasoning as every other contextual permission here. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- BOOT_COMPLETED rescheduling round — re-arms escalation alarms after a reboot or app update,
         both of which clear every AlarmManager exact alarm outright. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".FueruApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Fueru">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Fueru"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Escalation Engine, Stages 0-2 (spec §7.2/§8.2). -->
        <receiver
            android:name=".escalation.EscalationReceiver"
            android:exported="false" />

        <!-- BOOT_COMPLETED rescheduling round — self-re-arming daily trigger, only ever fired by this
             app's own PendingIntent. -->
        <receiver
            android:name=".escalation.DailyRescheduleReceiver"
            android:exported="false" />

        <!-- BOOT_COMPLETED rescheduling round — the only exported receiver in this app, since these
             are genuine system broadcasts. -->
        <receiver
            android:name=".escalation.BootCompletedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".escalation.EscalationLockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a full-screen alarm-style lock when a scheduled practice goes unmarked past its configured grace period." />
        </service>

        <activity
            android:name=".escalation.EscalationLockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Fueru" />
    </application>

</manifest>
